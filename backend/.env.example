# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Configuration
# Option 1: MongoDB Atlas (Remote) - Uncomment and add your credentials
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/clickfix?retryWrites=true&w=majority

# Option 2: Local MongoDB - Uncomment to use local database
MONGODB_URI=mongodb://localhost:27017/clickfix

# JWT Secret
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRE=30d

# Cloudinary (for image uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Client URL (for CORS)
CLIENT_URL=http://localhost:8081

# Google Directions API key (server-side, "Directions API" enabled)
GOOGLE_MAPS_API_KEY=your-server-google-key

# Email (Resend) - used to send password reset codes
# Render blocks outbound SMTP, so email is sent via Resend's HTTPS API instead
# of a traditional SMTP provider like Gmail. Get a key at https://resend.com
# (API Keys tab). Without a verified sending domain, Resend's free tier can
# only deliver to the email address you signed up with.
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM=ClickFix <noreply@your-verified-domain.com>
